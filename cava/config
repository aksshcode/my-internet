## CAVA — Fast, Responsive, Snappy Wave Tuning
## The exact configuration from the 2026-10-04 customization session ("the one that was good")

[general]
framerate = 80 
autosens = 1
sensitivity = 75
bars = 0
bar_width = 2
bar_spacing = 1
max_height = 100
lower_cutoff_freq = 60
higher_cutoff_freq = 12000
sleep_timer = 0

[input]
method = pipewire
source = auto

[output]
method = noncurses
orientation = bottom
channels = mono
mono_option = average
reverse = 0
xaxis = none
synchronized_sync = 0
show_idle_bar_heads = 0
waveform = 0

[color]
theme = 'cava-colors.ini'

[smoothing]
noise_reduction = 30
monstercat = 1
waves = 1

[eq]
1 = 0.55   ; Sub-bass (de-emphasized so low-end doesn't pin left edge)
2 = 0.70   ; Bass punch
3 = 1.15   ; Low-mids (vocals, body)
4 = 1.35   ; Mids
5 = 1.30   ; Upper-mids
6 = 1.15   ; Presence
7 = 1.00   ; Treble
8 = 0.85   ; Air
